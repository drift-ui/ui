{
  "name": "drift-ui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run registry:build && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.base-ui.json",
    "registry:build": "shadcn build && bun scripts/build-base-ui-registry.ts && shadcn build registry.base.json --output public/r/base && bun scripts/build-style-registry.ts",
    "test": "bun run registry:build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emojibase-data": "^18.0.0",
    "lenis": "^1.3.27",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.0.0",
    "motion": "^14.7.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.2",
    "react": "19.3.1",
    "react-day-picker": "10",
    "react-dom": "19.3.1",
    "shiki": "^4.5.0",
    "simple-icons": "^16.36.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.9.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  }
}
